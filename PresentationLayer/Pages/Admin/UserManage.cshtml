@page "{handler?}"
@model Presentation.Pages.Admin.UserManageModel
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Pages/Admin/_AdminLayout.cshtml";
}

<div class="um-page">
    <!-- Toolbar -->
    <div class="um-toolbar">
        <form method="get" asp-page="/Admin/UserManage" class="um-filters" id="filterForm">
            <div class="filter-group">
                <i class="fas fa-search filter-icon"></i>
                <input type="text" name="name" value="@Model.ViewModel.NameFilter" placeholder="Search by name..."
                       class="filter-input" id="filterName" />
            </div>
            <div class="filter-group">
                <i class="fas fa-envelope filter-icon"></i>
                <input type="text" name="email" value="@Model.ViewModel.EmailFilter" placeholder="Search by email..."
                       class="filter-input" id="filterEmail" />
            </div>
            <div class="filter-group">
                <i class="fas fa-tag filter-icon"></i>
                <select name="role" class="filter-select" id="filterRole">
                    <option value="">All Roles</option>
                    @foreach (var r in Model.ViewModel.AvailableRoles)
                    {
                        if (Model.ViewModel.RoleFilter == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <input type="hidden" name="limit" value="@Model.ViewModel.Limit" />
            <input type="hidden" name="offset" value="0" />
            <button type="submit" class="btn-filter">
                <i class="fas fa-filter"></i> Filter
            </button>
            <button type="button" class="btn-reset" id="btnReset">
                <i class="fas fa-times"></i> Reset
            </button>
        </form>
        <div class="um-actions">
            <button class="btn-import-user" id="btnImportUser" onclick="openImportModal()">
                <i class="fas fa-file-excel"></i>
                <span>Import Excel</span>
            </button>
            <button class="btn-add-user" id="btnAddUser" onclick="openCreateModal()">
                <i class="fas fa-user-plus"></i>
                <span>Add User</span>
            </button>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="um-stats">
        <div class="stat-item">
            <span class="stat-number">@Model.ViewModel.Users.Count</span>
            <span class="stat-label">Showing</span>
        </div>
        <div class="stat-separator"></div>
        <div class="stat-item">
            <span class="stat-number">
                @(Model.ViewModel.Offset + 1)–@(Model.ViewModel.Offset +
                Model.ViewModel.Users.Count)
            </span>
            <span class="stat-label">of <span id="totalUserCount">0</span> users</span>
        </div>
    </div>

    <!-- Table -->
    <div class="um-table-wrapper">
        <table class="um-table" id="userTable">
            <thead>
                <tr>
                    <th class="col-user">User</th>
                    <th class="col-email">Email</th>
                    <th class="col-role">Role</th>
                    <th class="col-status">Status</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.ViewModel.Users.Any())
                {
                    <tr>
                        <td colspan="5" class="um-empty">
                            <i class="fas fa-users-slash"></i>
                            <p>No users found matching your filters.</p>
                        </td>
                    </tr>
                }
                @foreach (var user in Model.ViewModel.Users)
                {
                    var rowClass = user.IsDeleted ? "row-deleted" : (!user.IsActive ? "row-disabled" : "");
                    <tr class="@rowClass" data-user-id="@user.Id">
                        <td class="col-user">
                            <div class="user-cell">
                                <div class="user-avatar">@user.FullName.Substring(0, 1).ToUpper()</div>
                                <div class="user-info">
                                    <span class="user-name">@user.FullName</span>
                                    <span class="user-id">@user.Id.ToString().Substring(0, 8)…</span>
                                </div>
                            </div>
                        </td>
                        <td class="col-email">@user.Email</td>
                        <td class="col-role">
                            <span class="role-badge role-@user.Role.ToLower()">@user.Role</span>
                        </td>
                        <td class="col-status">
                            @if (user.IsDeleted)
                            {
                                <span class="status-badge status-deleted"><i class="fas fa-trash"></i> Deleted</span>
                            }
                            else if (!user.IsActive)
                            {
                                <span class="status-badge status-disabled"><i class="fas fa-ban"></i> Disabled</span>
                            }
                            else
                            {
                                <span class="status-badge status-active"><i class="fas fa-check-circle"></i> Active</span>
                            }
                        </td>
                        <td class="col-actions">
                            @if (!user.IsDeleted)
                            {
                                <button class="action-btn btn-edit" title="Edit"
                                        onclick="openEditModal('@user.Id','@user.FullName','@user.Email','@user.Role','@user.UpdatedAt.ToString("o")')">
                                    <i class="fas fa-pen"></i>
                                </button>
                                @if (user.IsActive)
                                {
                                    <button class="action-btn btn-disable" title="Disable account"
                                            onclick="confirmDisable('@user.Id','@user.FullName','@user.UpdatedAt.ToString("o")')">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="action-btn btn-reactivate" title="Reactivate account"
                                            onclick="confirmReactivate('@user.Id','@user.FullName','@user.UpdatedAt.ToString("o")')">
                                        <i class="fas fa-play-circle"></i>
                                    </button>
                                }
                                <button class="action-btn btn-delete" title="Delete account"
                                        onclick="confirmDelete('@user.Id','@user.FullName')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            }
                            else
                            {
                                <span class="no-actions">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="um-pagination">
        <button id="btnPrev" class="pg-btn">
            <i class="fas fa-chevron-left"></i>
            <span>Prev</span>
        </button>
        <span class="pg-info">Page 1 / 1</span>
        <button id="btnNext" class="pg-btn">
            <span>Next</span>
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>


<!-- ═══════════════ CREATE MODAL ═══════════════ -->
<div class="modal-overlay" id="createModal">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="createTitle">
        <div class="modal-header">
            <h2 class="modal-title" id="createTitle"><i class="fas fa-user-plus"></i> Add New User</h2>
            <button class="modal-close" onclick="closeModal('createModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Full Name *</label>
                    <input type="text" id="create-name" class="form-control" placeholder="Enter full name" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email Address *</label>
                    <input type="email" id="create-email" class="form-control" placeholder="user@example.com" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Role *</label>
                    <select id="create-role" class="form-control form-select">
                        <option value="">— Select Role —</option>
                        @foreach (var r in Model.ViewModel.AvailableRoles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-alert modal-alert--info" style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.2);border-radius:8px;color:#3b82f6;font-size:13px;margin-top:4px;">
                <i class="fas fa-info-circle"></i>
                A secure password will be auto-generated and sent to the user's email. They will be required to change it on first login.
            </div>
            <div class="modal-alert" id="createAlert" hidden></div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('createModal')">Cancel</button>
            <button class="btn-modal-primary" onclick="submitCreate()" id="btnCreateSubmit">
                <i class="fas fa-paper-plane"></i> Create & Send Credentials
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════ EDIT MODAL ═══════════════ -->
<div class="modal-overlay" id="editModal">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="editTitle">
        <div class="modal-header">
            <h2 class="modal-title" id="editTitle"><i class="fas fa-user-edit"></i> Edit User</h2>
            <button class="modal-close" onclick="closeModal('editModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="edit-user-id" />
            <input type="hidden" id="edit-updated-at" />
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Full Name *</label>
                    <input type="text" id="edit-name" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email Address *</label>
                    <input type="email" id="edit-email" class="form-control" />
                    <small class="form-hint">Changing email will trigger a verification flow</small>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Role *</label>
                <select id="edit-role" class="form-control form-select">
                    @foreach (var r in Model.ViewModel.AvailableRoles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="modal-alert" id="editAlert" hidden></div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('editModal')">Cancel</button>
            <button class="btn-modal-primary" onclick="submitUpdate()" id="btnEditSubmit">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════ CONFIRM DELETE MODAL ═══════════════ -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-card modal-sm" role="dialog" aria-modal="true">
        <div class="modal-header modal-header-danger">
            <h2 class="modal-title"><i class="fas fa-trash-alt"></i> Delete User</h2>
            <button class="modal-close" onclick="closeModal('deleteModal')">×</button>
        </div>
        <div class="modal-body">
            <p class="confirm-text">Are you sure you want to delete <strong id="delete-user-name"></strong>?</p>
            <p class="confirm-subtext">This will soft-delete the account and notify the user via email.</p>
            <input type="hidden" id="delete-user-id" />
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-modal-danger" onclick="submitDelete()" id="btnDeleteSubmit">
                <i class="fas fa-trash-alt"></i> Yes, Delete
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════ CONFIRM DISABLE MODAL ═══════════════ -->
<div class="modal-overlay" id="disableModal">
    <div class="modal-card modal-sm" role="dialog" aria-modal="true">
        <div class="modal-header modal-header-warning">
            <h2 class="modal-title"><i class="fas fa-ban"></i> Disable Account</h2>
            <button class="modal-close" onclick="closeModal('disableModal')">×</button>
        </div>
        <div class="modal-body">
            <p class="confirm-text">Disable account for <strong id="disable-user-name"></strong>?</p>
            <p class="confirm-subtext">The user will be notified and cannot log in until reactivated.</p>
            <input type="hidden" id="disable-user-id" />
            <input type="hidden" id="disable-updated-at" />
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('disableModal')">Cancel</button>
            <button class="btn-modal-warning" onclick="submitDisable()" id="btnDisableSubmit">
                <i class="fas fa-ban"></i> Disable Account
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════ CONFIRM REACTIVATE MODAL ═══════════════ -->
<div class="modal-overlay" id="reactivateModal">
    <div class="modal-card modal-sm" role="dialog" aria-modal="true">
        <div class="modal-header modal-header-success">
            <h2 class="modal-title"><i class="fas fa-play-circle"></i> Reactivate Account</h2>
            <button class="modal-close" onclick="closeModal('reactivateModal')">×</button>
        </div>
        <div class="modal-body">
            <p class="confirm-text">Reactivate account for <strong id="reactivate-user-name"></strong>?</p>
            <p class="confirm-subtext">The user will be able to log in again after reactivation.</p>
            <input type="hidden" id="reactivate-user-id" />
            <input type="hidden" id="reactivate-updated-at" />
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('reactivateModal')">Cancel</button>
            <button class="btn-modal-primary" onclick="submitReactivate()" id="btnReactivateSubmit">
                <i class="fas fa-play-circle"></i> Reactivate
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════ IMPORT EXCEL MODAL ═══════════════ -->
<div class="modal-overlay" id="importModal">
    <div class="modal-card modal-lg" role="dialog" aria-modal="true">
        <div class="modal-header">
            <h2 class="modal-title"><i class="fas fa-file-excel"></i> Import Users</h2>
            <button class="modal-close" onclick="closeModal('importModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="import-instructions">
                <p>Upload an Excel file (.xlsx) containing user data.</p>
                <p>Required columns: <strong>Full Name</strong>, <strong>Email</strong>, <strong>Role</strong>.</p>
                <a href="?handler=DownloadTemplate" class="btn-download-template" download>
                    <i class="fas fa-download"></i> Download Template
                </a>
                <button class="btn-view-history" onclick="openImportHistoryModal()">
                    <i class="fas fa-history"></i> View Import History
                </button>
            </div>
            <form id="importForm" onsubmit="submitImport(event)">
                <div class="form-group">
                    <label for="importFile">Select Excel File:</label>
                    <input type="file" id="importFile" name="file" accept=".xlsx" required class="form-control" />
                </div>
                <div id="importProgress" class="progress-container" style="display: none;">
                    <div class="progress-info">
                        <span id="importStatusText">Uploading...</span>
                        <span id="importPercentage">0%</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar" id="importProgressBar" style="width: 0%"></div>
                    </div>
                    <div class="progress-stats" id="importStats" style="display: none;">
                        <span class="text-success"><i class="fas fa-check"></i> <span id="importSuccessCount">0</span> success</span>
                        <span class="text-danger"><i class="fas fa-times"></i> <span id="importFailedCount">0</span> failed</span>
                        <span class="text-muted">Total: <span id="importTotalCount">0</span></span>
                    </div>
                    <div id="importErrorLog" class="import-error-log" style="display: none;"></div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('importModal')" id="btnImportCancel">Close</button>
            <button type="submit" form="importForm" class="btn-modal-primary" id="btnImportSubmit">
                <i class="fas fa-upload"></i> Upload & Import
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════ IMPORT HISTORY MODAL ═══════════════ -->
<div class="modal-overlay" id="importHistoryModal">
    <div class="im-modal" role="dialog" aria-modal="true" aria-labelledby="ihTitle">

        <!-- Header -->
        <div class="im-header">
            <div class="im-header-icon">
                <i class="fas fa-clock-rotate-left"></i>
            </div>
            <div>
                <h2 class="im-title" id="ihTitle">Import History</h2>
                <p class="im-subtitle">Track and review all file import jobs</p>
            </div>
            <button class="im-close" onclick="closeModal('importHistoryModal')" aria-label="Close">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <!-- Search toolbar -->
        <div class="im-toolbar">
            <div class="im-search-wrap">
                <i class="fas fa-magnifying-glass im-search-icon"></i>
                <input type="text" id="historyFilterFileName"
                       class="im-search-input"
                       placeholder="Search by file name…"
                       onkeyup="onHistorySearchInput()" />
                <button id="btnClearHistorySearch" class="im-clear-btn" onclick="clearHistorySearch()" style="display:none" aria-label="Clear">
                    <i class="fas fa-circle-xmark"></i>
                </button>
            </div>
            <button class="im-btn-primary" onclick="searchImportHistory()">
                <i class="fas fa-magnifying-glass"></i>
                <span>Search</span>
            </button>
        </div>

        <!-- Table -->
        <div class="im-table-wrap">
            <table class="im-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>File Name</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Records</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="importHistoryTableBody">
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="im-footer">
            <div class="im-pagination">
                <button id="btnHistoryPrev" class="im-pg-btn" onclick="prevHistoryPage()">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <span id="historyPgInfo" class="im-pg-info">Page 1 / 1</span>
                <button id="btnHistoryNext" class="im-pg-btn" onclick="nextHistoryPage()">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
            <button class="im-btn-ghost" onclick="closeModal('importHistoryModal')">Close</button>
        </div>

    </div>
</div>

<!-- ═══════════════ IMPORT DETAIL MODAL ═══════════════ -->
<div class="modal-overlay" id="importDetailModal">
    <div class="im-modal im-modal-lg" role="dialog" aria-modal="true" aria-labelledby="idTitle">

        <!-- Header -->
        <div class="im-header im-header-detail">
            <button class="im-back-btn" onclick="openImportHistoryModal()" aria-label="Back to history">
                <i class="fas fa-arrow-left"></i>
            </button>
            <div class="flex-grow-1 overflow-hidden">
                <h2 class="im-title im-title-light" id="idTitle">Batch Details</h2>
                <p class="im-filename" id="detailFileName">—</p>
            </div>
            <button class="im-close im-close-light" onclick="closeModal('importDetailModal')" aria-label="Close">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <!-- Stats row -->
        <div class="im-stats-bar">
            <div class="im-stat im-stat-status">
                <span class="im-stat-label">Status</span>
                <span id="detailStatusBadge"></span>
            </div>
            <div class="im-stat">
                <span class="im-stat-label">Total</span>
                <span class="im-stat-value" id="detailTotal">—</span>
            </div>
            <div class="im-stat im-stat-success">
                <span class="im-stat-label">
                    <i class="fas fa-circle-check"></i> Success
                </span>
                <span class="im-stat-value im-success" id="detailSuccess">—</span>
            </div>
            <div class="im-stat im-stat-danger">
                <span class="im-stat-label">
                    <i class="fas fa-circle-xmark"></i> Failed
                </span>
                <span class="im-stat-value im-danger" id="detailFailed">—</span>
            </div>
        </div>

        <!-- Search toolbar -->
        <div class="im-toolbar im-toolbar-light">
            <div class="im-search-wrap">
                <i class="fas fa-envelope im-search-icon"></i>
                <input type="text" id="detailFilterEmail"
                       class="im-search-input"
                       placeholder="Filter by email address…"
                       onkeyup="onDetailSearchInput()" />
                <button id="btnClearDetailSearch" class="im-clear-btn" onclick="clearDetailSearch()" style="display:none" aria-label="Clear">
                    <i class="fas fa-circle-xmark"></i>
                </button>
            </div>
            <button class="im-btn-primary" onclick="searchBatchRows()">
                <i class="fas fa-magnifying-glass"></i>
                <span>Search</span>
            </button>
        </div>

        <!-- Table -->
        <div class="im-table-wrap">
            <table class="im-table">
                <thead>
                    <tr>
                        <th style="width:70px">#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th style="width:110px">Role</th>
                        <th style="width:120px">Status</th>
                        <th>Error Message</th>
                    </tr>
                </thead>
                <tbody id="importDetailTableBody">
                </tbody>
            </table>
        </div>

        <!-- Footer / Pagination -->
        <div class="im-footer">
            <div class="im-pagination">
                <button id="btnDetailPrev" class="im-pg-btn" onclick="prevDetailPage()">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <span id="detailPgInfo" class="im-pg-info">Page 1 / 1</span>
                <button id="btnDetailNext" class="im-pg-btn" onclick="nextDetailPage()">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
            <button class="im-btn-ghost" onclick="closeModal('importDetailModal')">Close</button>
        </div>

    </div>
</div>

<!-- Toast -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/admin/admin-user-manage.js"></script>
}
