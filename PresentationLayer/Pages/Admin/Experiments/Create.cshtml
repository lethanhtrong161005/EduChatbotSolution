@page "{handler?}"
@model Presentation.Pages.Admin.Experiments.CreateModel
@{
    ViewData["Title"] = "Create Experiment";
    Layout = "~/Pages/Admin/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/admin-experiment-create.css" asp-append-version="true" />

<div class="sm-page">
    <!-- Header -->
    <div class="page-header-row">
        <div class="header-left">
            <h1 class="page-title-text"><i class="fas fa-flask text-primary"></i> Create AI Experiment</h1>
            <p class="page-subtitle-text">Set up configuration, select test questions, and run RAG evaluation benchmark benchmarks.</p>
        </div>
    </div>

    <!-- Toolbar aligned with native SubjectManage layout -->
    <div class="sm-toolbar">
        <div class="sm-filters">
            <div class="subject-select-wrapper">
                <label for="subjectSelect" class="select-label">Select Subject:</label>
                <select id="subjectSelect" class="form-control form-select">
                    <option value="" disabled selected>-- Choose Subject --</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Alert Message Container -->
    <div class="alert-container" id="alertContainer" hidden></div>

    <!-- Main Content Grid (Hidden until subject selected) -->
    <div id="experimentFormContainer" style="display: none;">
        <form id="experimentForm" onsubmit="event.preventDefault();">
            <div class="experiment-grid">
                
                <!-- Left Column: Settings -->
                <div class="grid-col-left">
                    
                    <!-- General Details -->
                    <div class="config-card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-info-circle text-primary"></i> General Details</h3>
                        </div>
                        <div class="card-body padding-card">
                            <div class="form-group mb-3">
                                <label class="form-label">Experiment Name *</label>
                                <input type="text" id="experimentName" class="form-control" placeholder="e.g. DB201 recursive Gemini smoke run" required />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Notes / Description</label>
                                <textarea id="notes" class="form-control" style="resize: vertical; min-height: 70px;" placeholder="Optional notes about this experiment run..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Indexing Configuration -->
                    <div class="config-card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-database text-info"></i> Indexing Configuration</h3>
                        </div>
                        <div class="card-body padding-card">
                            <div class="form-group mb-3">
                                <label class="form-label">Chunking Strategy *</label>
                                <select id="chunkingStrategy" class="form-control form-select preflight-trigger" required>
                                    <!-- Populated dynamically -->
                                </select>
                            </div>
                            <div class="form-row mb-3">
                                <div class="form-group col-6">
                                    <label class="form-label">Chunk Size (chars) *</label>
                                    <input type="number" id="chunkSize" class="form-control preflight-trigger" min="100" max="8000" step="1" required />
                                </div>
                                <div class="form-group col-6">
                                    <label class="form-label">Chunk Overlap (chars) *</label>
                                    <input type="number" id="chunkOverlap" class="form-control preflight-trigger" min="0" step="1" required />
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Embedding Model *</label>
                                <select id="embeddingModel" class="form-control form-select preflight-trigger" required>
                                    <!-- Populated dynamically -->
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Retrieval & Generation Configuration -->
                    <div class="config-card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-search-plus text-warning"></i> Retrieval & Generation</h3>
                        </div>
                        <div class="card-body padding-card">
                            <div class="form-row mb-3">
                                <div class="form-group col-4">
                                    <label class="form-label">Top K *</label>
                                    <input type="number" id="topK" class="form-control" min="1" step="1" required />
                                </div>
                                <div class="form-group col-4">
                                    <label class="form-label">Similarity Threshold *</label>
                                    <input type="number" id="similarityThreshold" class="form-control" min="0" max="1" step="0.01" required />
                                </div>
                                <div class="form-group col-4">
                                    <label class="form-label">Max Context Chunks *</label>
                                    <input type="number" id="maxContextChunks" class="form-control" min="1" step="1" required />
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">LLM Model *</label>
                                <select id="llmModel" class="form-control form-select" required>
                                    <!-- Populated dynamically -->
                                </select>
                            </div>
                            <div class="form-row mb-3">
                                <div class="form-group col-6">
                                    <label class="form-label">Temperature *</label>
                                    <input type="number" id="chatTemperature" class="form-control" min="0" max="2" step="0.1" required />
                                </div>
                                <div class="form-group col-6">
                                    <label class="form-label">Judge Model *</label>
                                    <select id="judgeModel" class="form-control form-select" required>
                                        <!-- Populated dynamically -->
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Question Selection & Launch -->
                <div class="grid-col-right">
                    
                    <!-- Preflight Checker Card -->
                    <div class="config-card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-clipboard-check text-success"></i> Preflight Index Checker</h3>
                        </div>
                        <div class="card-body padding-card">
                            <div id="preflightStatusBox" class="preflight-status-box preflight-pending">
                                <div class="preflight-status-icon">
                                    <i class="fas fa-hourglass-start"></i>
                                </div>
                                <div class="preflight-status-details">
                                    <h4 class="preflight-title">Pending Check</h4>
                                    <p class="preflight-desc">Enter indexing settings to run index compatibility checks.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dataset & Question Selector -->
                    <div class="config-card">
                        <div class="card-header header-flex">
                            <h3 class="card-title"><i class="fas fa-tasks text-success"></i> Test Dataset Selection</h3>
                            <div class="dataset-shortcuts">
                                <button type="button" class="btn-shortcut" onclick="selectQuickRun()">Quick Run (3)</button>
                                <button type="button" class="btn-shortcut" onclick="selectAllQuestions()">Select All (50)</button>
                                <button type="button" class="btn-shortcut btn-shortcut-clear" onclick="clearAllQuestions()">Clear</button>
                            </div>
                        </div>
                        <div class="card-body padding-card">
                            <div class="question-list-header">
                                <span class="selected-count" id="selectedCountText">0 selected</span>
                            </div>
                            <div class="question-scroll-list" id="questionList">
                                <!-- Populated dynamically -->
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="launch-actions-wrapper">
                        <button type="submit" class="btn-launch-experiment" id="btnLaunchExperiment" onclick="launchExperiment()">
                            <i class="fas fa-play"></i> Run Experiment
                        </button>
                    </div>

                </div>

            </div>
        </form>
    </div>
</div>

<!-- Modal: Confirm Reindex and Run -->
<div class="modal-overlay" id="confirmLaunchModal">
    <div class="modal-card modal-sm" role="dialog" aria-modal="true">
        <div class="modal-header modal-header-warning">
            <h2 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Reindex Confirmation Required</h2>
            <button class="modal-close" onclick="closeModal('confirmLaunchModal')">×</button>
        </div>
        <div class="modal-body">
            <p class="confirm-text">This experiment requires a <strong>complete reindexing</strong> of the subject's document database.</p>
            <p class="confirm-subtext" style="margin-top: 10px;">The system will reindex <strong id="confirm-doc-count" style="color: #d97706;"></strong> documents of <strong id="confirm-subject-code" style="color: #d97706;"></strong> before executing the test questions.</p>
            <p class="confirm-subtext text-danger" style="margin-top: 5px;"><strong>Important:</strong> Chat function for this subject will be temporarily locked during the reindexing phase. After completion, this new configuration will remain active for the subject.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-modal-cancel" onclick="closeModal('confirmLaunchModal')">Cancel</button>
            <button class="btn-modal-warning" onclick="submitExperimentCreation(true)" id="btnConfirmLaunchSubmit">
                <i class="fas fa-play"></i> Agree and Launch
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-experiment-create.js" asp-append-version="true"></script>
}
