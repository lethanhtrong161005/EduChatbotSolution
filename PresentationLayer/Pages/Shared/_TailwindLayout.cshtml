@using Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Presentation.Common

@inject SignInManager<ApplicationUser> SignInManager

@{
    var authenticated = SignInManager.IsSignedIn(User);
    var isAdmin = User.IsInRole(UserRole.Admin.ToString());
    var isLecturer = User.IsInRole(UserRole.Lecturer.ToString());
    var isStudent = User.IsInRole(UserRole.Student.ToString());
}

<!DOCTYPE html>

<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduChatAI</title>

    <script type="importmap"></script>

    <!-- App Styles -->
    <link rel="stylesheet" href="~/Presentation.styles.css" asp-append-version="true" />

    <!-- Design System -->
    <link rel="stylesheet" href="~/css/colors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />

    <!-- Layout Styles (non-Bootstrap) -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/font-awesome/css/all.min.css" asp-append-version="true" />
</head>

<body class="min-h-screen bg-[var(--color-bg-neutral)] text-[var(--color-text-primary)]">

    <!-- ======================================================
         BACKGROUND
         ====================================================== -->

    <div class="page-background"></div>

    <!-- ======================================================
         APP SHELL
         ====================================================== -->

    <div class="flex min-h-screen flex-col">

        <!-- ======================================================
             HEADER
             ====================================================== -->

        <header class="navbar-educhat">

            <div class="flex w-full items-center justify-between px-4 lg:px-6 relative z-10">


                <!-- Brand -->

                <a class="navbar-brand no-underline py-[5px] mr-4" asp-area="" asp-page="/Home/Index">
                    <div class="brand-logo">
                        <i class="fas fa-robot"></i>
                    </div>
                    <span class="brand-name">EduChatAI</span>
                </a>

                <!-- Main Navigation -->

                <nav class="hidden flex-1 items-center lg:flex">

                    <div class="flex-1 flex items-center">

                        <a asp-page="/Home/Index"
                           class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                            @(NavBar.HomeNavClass(Context) == "active"
                                ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                            Home
                        </a>

                        <a asp-page="/Chat/Index"
                           class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                            @(NavBar.ChatNavClass(Context) == "active"
                                ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                            Chat
                        </a>

                        @if (isLecturer || isAdmin)
                        {
                            <a asp-page="/Documents/Library"
                               class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                                @(NavBar.DocumentsNavClass(Context) == "active"
                                    ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                    : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                                Documents
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a asp-page="/Admin/SubjectManage"
                               class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                                @(NavBar.AdminNavClass(Context) == "active"
                                    ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                    : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                                Manage
                            </a>

                            <a href="/rbl"
                               class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                                @(NavBar.RblNavClass(Context) == "active"
                                    ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                    : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                                Analyze
                            </a>
                        }

                    </div>

                    <div class="flex items-center gap-2">

                        @if (authenticated)
                        {
                            @if (isStudent || isLecturer)
                            {
                                <a asp-page="/Subscriptions/SelectPlan"
                                   class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                                    @(NavBar.PlansNavClass(Context) == "active"
                                        ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                        : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                                    Plans
                                </a>
                            }

                            <a asp-page="/Account/Profile"
                               class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]
                                @(NavBar.ProfileNavClass(Context) == "active"
                                    ? "bg-[#2ecc711a] text-(--color-primary-dark)"
                                    : "text-slate-600 hover:bg-[#2ecc711a] hover:text-(--color-primary-dark)")">
                                Profile
                            </a>

                            <form method="post"
                                  asp-page="/Account/Logout"
                                  asp-route-return-url="@Context.Request.Path">

                                <button type="submit"
                                        class="rounded-md px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium transition hover:-translate-y-[1px]"
                                        style="color: #ef4444; background: rgba(239,68,68,0.08);"
                                        onmouseover="this.style.background='rgba(239,68,68,0.15)'; this.style.color='#dc2626';"
                                        onmouseout="this.style.background='rgba(239,68,68,0.08)'; this.style.color='#ef4444';">
                                    Log out
                                </button>

                            </form>
                        }
                        else
                        {
                            <a asp-page="/Account/Register"
                               asp-route-return-url="@Context.Request.Path"
                               class="rounded-lg px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                                Register
                            </a>

                            <a asp-page="/Account/Login"
                               asp-route-return-url="@Context.Request.Path"
                               class="rounded-lg bg-emerald-600 px-3.5 py-2 mx-0.5 text-sm leading-[1.6] tracking-[0.2px] font-semibold text-white transition hover:bg-emerald-700">
                                Log in
                            </a>
                        }

                    </div>

                </nav>

            </div>

        </header>

        <!-- ======================================================
             MAIN CONTENT
             ====================================================== -->

        <main class="flex-1 py-8">

            <div class="w-full max-w-[1900px] px-4">

                @if (ViewData["PageTitle"] != null)
                {
                    <header class="mb-8">

                        <h1 class="text-4xl font-bold tracking-tight text-slate-900">
                            @ViewData["PageTitle"]
                        </h1>

                        @if (ViewData["PageSubtitle"] != null)
                        {
                            <p class="mt-2 text-slate-600">
                                @ViewData["PageSubtitle"]
                            </p>
                        }

                    </header>
                }

                @RenderBody()

            </div>

        </main>

        <!-- ======================================================
             FOOTER
             ====================================================== -->

        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-brand-icon">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <span class="brand-name">EduChatAI</span>
                        <div class="text-muted">Smart Educational Companion</div>
                    </div>
                </div>

                <div class="footer-links">
                    <div class="footer-link-group">
                        <div class="footer-link-title">Product</div>
                        <a asp-page="/Home/Index">Features</a>
                        <a asp-page="/Subscriptions/SelectPlan">Pricing</a>
                    </div>
                    <div class="footer-link-group">
                        <div class="footer-link-title">Support</div>
                        <a href="#">Help Center</a>
                        <a href="#">Contact Us</a>
                    </div>
                    <div class="footer-link-group">
                        <div class="footer-link-title">Legal</div>
                        <a asp-page="/Home/Privacy">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="copyright">
                    &copy; @DateTime.UtcNow.Year EduChatAI. All rights reserved.
                </div>
                <div class="footer-socials">
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="GitHub"><i class="fab fa-github"></i></a>
                    <a href="#" aria-label="Discord"><i class="fab fa-discord"></i></a>
                </div>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
