<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EduChatAI</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- App Styles -->
    <link rel="stylesheet" href="~/Presentation.styles.css" asp-append-version="true" />

    <!-- Design System -->
    <link rel="stylesheet" href="~/css/colors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />

    <!-- Layout Styles -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <!-- Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/font-awesome/css/all.min.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="page-background"></div>

    <div class="app-shell">

        <!-- ==========================================
             HEADER / NAVBAR
             ========================================== -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-light navbar-educhat">
                <div class="container-fluid px-4">

                    <a class="navbar-brand" asp-area="" asp-page="/Home/Index">
                        <div class="brand-logo">
                            <i class="fas fa-robot"></i>
                        </div>

                        <span class="brand-name">EduChatAI</span>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <partial name="_NavBar" />
                    </div>
                </div>
            </nav>
        </header>

        <!-- ==========================================
             MAIN CONTENT
             ========================================== -->
        <main class="@(ViewData["NoContainer"] as bool? == true ? "flex-grow-1" : "content-wrapper")">
            @if (ViewData["NoContainer"] as bool? == true)
            {
                @RenderBody()
            }
            else
            {
                <div class="content-container">

                    @if (ViewData["PageTitle"] != null)
                    {
                        <div class="page-header">
                            <h1 class="page-title">
                                @ViewData["PageTitle"]
                            </h1>

                            @if (ViewData["PageSubtitle"] != null)
                            {
                                <p class="page-subtitle">
                                    @ViewData["PageSubtitle"]
                                </p>
                            }
                        </div>
                    }

                    @RenderBody()

                </div>
            }
        </main>

        <!-- ==========================================
             FOOTER
             ========================================== -->
        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-brand-icon">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <span class="brand-name">EduChatAI</span>
                        <div class="text-muted">Smart Educational Companion</div>
                    </div>
                </div>

                <div class="footer-links">
                    <div class="footer-link-group">
                        <div class="footer-link-title">Product</div>
                        <a asp-page="/Home/Index">Features</a>
                        <a asp-page="/Subscriptions/SelectPlan">Pricing</a>
                    </div>
                    <div class="footer-link-group">
                        <div class="footer-link-title">Support</div>
                        <a href="#">Help Center</a>
                        <a href="#">Contact Us</a>
                    </div>
                    <div class="footer-link-group">
                        <div class="footer-link-title">Legal</div>
                        <a asp-page="/Home/Privacy">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <div class="copyright">
                    &copy; @DateTime.UtcNow.Year EduChatAI. All rights reserved.
                </div>
                <div class="footer-socials">
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="GitHub"><i class="fab fa-github"></i></a>
                    <a href="#" aria-label="Discord"><i class="fab fa-discord"></i></a>
                </div>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (TempData["GlobalError"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.showToast) {
                    window.showToast('@Html.Raw(TempData["GlobalError"])', 'error');
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
