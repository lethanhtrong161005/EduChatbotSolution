@page "/force-change-password"
@model Presentation.Pages.Account.ForceChangePasswordModel
@{
    ViewData["Title"] = "Change Password - EduChatAI";
    Layout = "_AuthLayout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/colors.css">
    <link rel="stylesheet" href="~/css/account-auth.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="bg-animation"></div>

    <div class="container-login">
        <div class="login-sidebar d-none d-lg-flex">
            <div class="sidebar-content">
                <div class="sidebar-logo">
                    <i class="fas fa-robot"></i>
                </div>
                <h2 class="sidebar-title">EduChatAI</h2>
                <p class="sidebar-subtitle">Smart Educational Companion</p>

                <ul class="sidebar-features">
                    <li>
                        <i class="fas fa-shield-alt"></i>
                        <span>Security First</span>
                    </li>
                    <li>
                        <i class="fas fa-key"></i>
                        <span>Set Your Own Password</span>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <span>Start Learning</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="login-form-container">
            <div class="login-form-box">
                <div class="login-header login-header--compact">
                    <h1>Change Your Password</h1>
                    <p class="login-subtitle" style="margin-top:4px;font-size:14px;color:#6b7280;">
                        Your account was created by an administrator.
                        Please set a new personal password to continue.
                    </p>
                </div>

                <div class="fcp-notice">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div>
                        For your security, you must change the temporary password
                        that was sent to your email before you can access your account.
                    </div>
                </div>

                @if (ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
                {
                    <div class="alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        @Html.ValidationSummary(false)
                    </div>
                }

                <form method="post" asp-page="/Account/ForceChangePassword" class="fcp-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ViewModel.Email" />

                    <div class="form-group">
                        <label class="form-label" asp-for="ViewModel.CurrentPassword">
                            <i class="fas fa-lock"></i> Current Password
                        </label>
                        <div class="input-icon-wrapper">
                            <input type="password"
                                   id="currentPwd"
                                   class="form-control form-control-with-icon"
                                   asp-for="ViewModel.CurrentPassword"
                                   placeholder="Enter the password from your email"
                                   required>
                            <i class="fas fa-lock input-icon"></i>
                            <button type="button" class="eye-toggle" onclick="togglePassword('currentPwd', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ViewModel.CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="ViewModel.NewPassword">
                            <i class="fas fa-key"></i> New Password
                        </label>
                        <div class="input-icon-wrapper">
                            <input type="password"
                                   id="newPwd"
                                   class="form-control form-control-with-icon"
                                   asp-for="ViewModel.NewPassword"
                                   placeholder="Min 8 characters"
                                   required>
                            <i class="fas fa-key input-icon"></i>
                            <button type="button" class="eye-toggle" onclick="togglePassword('newPwd', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ViewModel.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="ViewModel.ConfirmPassword">
                            <i class="fas fa-check-double"></i> Confirm New Password
                        </label>
                        <div class="input-icon-wrapper">
                            <input type="password"
                                   id="confirmPwd"
                                   class="form-control form-control-with-icon"
                                   asp-for="ViewModel.ConfirmPassword"
                                   placeholder="Re-enter your new password"
                                   required>
                            <i class="fas fa-check-double input-icon"></i>
                            <button type="button" class="eye-toggle" onclick="togglePassword('confirmPwd', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ViewModel.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-change-pwd">
                        <i class="fas fa-shield-alt"></i>
                        Change Password & Continue
                    </button>
                </form>

                <div class="signup-link mt-3">
                    Need help?
                    <a href="/login">Back to Login</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>


</body>
</html>

