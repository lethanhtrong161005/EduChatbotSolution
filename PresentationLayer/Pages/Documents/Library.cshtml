@page "{id:guid?}/{handler?}"

@using System.Security.Claims

@model Presentation.Pages.Documents.LibraryModel

@{
    ViewData["Title"] = "Knowledge Base";
    Layout = "_TailwindLayout";
}

<link rel="stylesheet" href="~/css/status-badge.css" asp-append-version="true" />

<div class="min-h-screen bg-slate-950 text-slate-100">

    <div class="mx-auto max-w-[1900px] p-8">

        <!-- ===================================================== -->
        <!-- PAGE HEADER                                            -->
        <!-- ===================================================== -->

        <header class="mb-8 flex items-center justify-between">

            <div>

                <h1 class="text-4xl font-bold tracking-tight">
                    Knowledge Base
                </h1>

                <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">

                    Browse subjects, chapters and knowledge sources powering
                    EduChatAI.

                </p>

            </div>

            <div id="uploadPrivilegeBadge">

                <!-- Rendered dynamically -->

            </div>

        </header>

        <!-- ===================================================== -->
        <!-- MAIN SHELL                                             -->
        <!-- ===================================================== -->

        <section class="grid grid-cols-[280px_280px_minmax(0,1fr)] gap-6">

            <!-- ================================================= -->
            <!-- SUBJECT SIDEBAR                                   -->
            <!-- ================================================= -->

            <aside id="subjectSidebar"
                   class="h-[calc(100vh-calc(var(--spacing)*20))] sticky top-10 flex flex-col overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-2xl">

                <div class="border-b border-slate-800 px-6 py-5">

                    <div>

                        <div class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">
                            Navigation
                        </div>

                        <h2 class="mt-2 text-lg font-semibold">
                            Subjects
                        </h2>

                    </div>

                </div>

                <div id="subjectSidebarContent"
                     class="flex-1 overflow-y-auto">

                    <!-- Filled by document-library.js -->

                </div>

            </aside>

            <!-- ================================================= -->
            <!-- CHAPTER SIDEBAR                                   -->
            <!-- ================================================= -->

            <aside id="chapterSidebar"
                   class="h-[calc(100vh-calc(var(--spacing)*20))] sticky top-10 flex flex-col overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-2xl">

                <div class="border-b border-slate-800 px-6 py-5">

                    <div>

                        <div class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">
                            Navigation
                        </div>

                        <h2 class="mt-2 text-lg font-semibold">
                            Chapters
                        </h2>

                    </div>

                </div>

                <div id="chapterSidebarContent"
                     class="flex-1 overflow-y-auto">

                    <!-- Filled by document-library.js -->

                </div>

            </aside>

            <!-- ================================================= -->
            <!-- MAIN CONTENT COLUMN                               -->
            <!-- ================================================= -->

            <main class="min-w-0">

                <div class="space-y-8">

                    <!-- ========================================= -->
                    <!-- MAIN SECTION                              -->
                    <!-- ========================================= -->

                    <section id="mainSection"
                             class="overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-2xl">

                        <!-- ===================================== -->
                        <!-- HEADER                               -->
                        <!-- ===================================== -->

                        <header class="border-b border-slate-800 px-8 py-4">

                            <div class="flex items-center justify-between gap-6">

                                <!-- Breadcrumb -->

                                <div id="mainBreadcrumb"
                                     class="flex items-center justify-center gap-3 overflow-hidden">

                                    <!-- Rendered dynamically -->

                                </div>

                                <!-- Navigation -->

                                <div class="flex items-center gap-3">

                                    <button id="mainBackBtn"
                                            type="button"
                                            class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-700 bg-slate-800 text-slate-300 transition hover:border-emerald-500 hover:text-white disabled:pointer-events-none disabled:opacity-40">

                                        <i class="fa-solid fa-chevron-left"></i>

                                    </button>

                                    <button id="mainForwardBtn"
                                            type="button"
                                            class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-700 bg-slate-800 text-slate-300 transition hover:border-emerald-500 hover:text-white disabled:pointer-events-none disabled:opacity-40">

                                        <i class="fa-solid fa-chevron-right"></i>

                                    </button>

                                </div>

                            </div>

                        </header>

                        <!-- ===================================== -->
                        <!-- CONTENT                               -->
                        <!-- ===================================== -->

                        <div id="mainSectionContent"
                             class="relative">

                            <section id="subjectGridLayer"
                                     class="inset-0 overflow-y-auto px-5 py-0 transition-all duration-300 ease-out">
                            </section>

                            <section id="subjectDetailsLayer"
                                     class="inset-0 overflow-y-auto px-5 py-0 transition-all duration-300 ease-out">
                            </section>

                            <section id="chapterDetailsLayer"
                                     class="inset-0 overflow-y-auto px-5 py-0 transition-all duration-300 ease-out">
                            </section>

                        </div>

                        <!-- ===================================== -->
                        <!-- FOOTER                                -->
                        <!-- ===================================== -->

                        <footer class="border-t border-slate-800 p-6">

                            <button id="showUploadBtn"
                                    type="button"
                                    class="group flex w-full items-center justify-between rounded-2xl px-6 py-5 text-left border transition">

                                <div>

                                    <div class="text-lg font-semibold text-emerald-300">

                                        Upload Documents

                                    </div>

                                    <div class="mt-1 text-sm text-slate-400">

                                        Upload files into the selected subject.

                                    </div>

                                </div>

                                <i id="showUploadChevron"
                                   class="fa-solid fa-chevron-down text-xl text-emerald-300 transition-transform duration-300"></i>

                            </button>

                        </footer>

                    </section>

                    <!-- ========================================= -->
                    <!-- UPLOAD PANEL                              -->
                    <!-- ========================================= -->

                    <div id="uploadSectionContainer"
                         class="transition-all duration-300">

                        <section id="uploadSection"
                                 class="rounded-3xl border border-slate-700 bg-slate-800 shadow-2xl">

                            <div class="border-b border-slate-700 px-8 py-6">

                                <div class="flex items-center justify-between">

                                    <div>

                                        <div class="text-xs font-semibold uppercase tracking-[0.25em] text-emerald-400">
                                            Upload
                                        </div>

                                        <h2 class="text-xl font-semibold text-slate-100">
                                            Upload documents
                                        </h2>

                                        <p id="uploadSubjectSummary">

                                            <!-- Rendered dynamically -->

                                        </p>

                                    </div>

                                </div>

                            </div>

                            <div class="space-y-8 p-8">

                                <!-- ====================================== -->
                                <!-- DROP ZONE                              -->
                                <!-- ====================================== -->

                                <section>

                                    <div id="dropZone"
                                         class="rounded-2xl border-2 border-dashed border-emerald-500 bg-slate-900/60 px-10 py-14 text-center transition hover:border-emerald-400 [&.dragover]:bg-[#2ecc7114]">

                                        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-emerald-600/15 text-4xl text-emerald-400">

                                            <i class="fa-solid fa-cloud-arrow-up"></i>

                                        </div>

                                        <h3 class="mt-6 text-xl font-semibold text-slate-100">
                                            Drag files here
                                        </h3>

                                        <p class="mt-3 text-sm text-slate-400">
                                            PDF · DOCX · PPTX · HTML · TXT
                                        </p>

                                        <input id="fileInput"
                                               hidden
                                               multiple
                                               type="file"
                                               accept=".pdf,.docx,.pptx,.txt,.html" />

                                        <button id="browseBtn"
                                                type="button"
                                                class="mt-8 rounded-xl bg-emerald-600 px-6 py-3 font-medium text-white transition hover:bg-emerald-500">

                                            Browse Files

                                        </button>

                                    </div>

                                </section>

                                <!-- ====================================== -->
                                <!-- CHAPTER TAGS                           -->
                                <!-- ====================================== -->

                                <section>

                                    <div class="mb-4">

                                        <h3 class="text-lg font-semibold text-slate-100">

                                            Chapter tags

                                        </h3>

                                        <p class="mt-1 text-sm text-slate-400">

                                            Optional. Leave empty for subject-wide documents.

                                        </p>

                                    </div>

                                    <div id="uploadChapterTags"
                                         class="flex flex-wrap gap-3">

                                        <!-- Rendered dynamically -->

                                    </div>

                                </section>

                            </div>

                            <div id="uploadOverlay"
                                 class="absolute inset-0 hidden items-center justify-center rounded-3xl bg-slate-900/70 backdrop-blur-sm">

                                <div class="h-12 w-12 animate-spin rounded-full border-4 border-emerald-500 border-t-transparent"></div>

                            </div>

                        </section>

                    </div>

                    <!-- ========================================= -->
                    <!-- DOCUMENT DRAWER                           -->
                    <!-- ========================================= -->

                    <section id="documentDrawerSection"
                             class="overflow-hidden opacity-0 -translate-y-4 scale-[0.985] pointer-events-none transition-all duration-300 ease-out max-h-0">

                        <div class="overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-2xl">

                            <div class="border-b border-slate-800 px-8 py-6">

                                <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">

                                    <div>

                                        <div class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500">

                                            Library

                                        </div>

                                        <h2 class="mt-2 text-2xl font-bold">

                                            Documents

                                        </h2>

                                        <p class="mt-2 text-sm text-slate-400">

                                            Browse documents belonging to the
                                            selected subject or chapter.

                                        </p>

                                    </div>

                                    <div class="w-full lg:w-96">

                                        <input id="searchInput"
                                               type="text"
                                               placeholder="Search documents..."
                                               class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 outline-none transition placeholder:text-slate-500 focus:border-emerald-500" />

                                    </div>

                                </div>

                            </div>

                            <div id="documentList">

                                <!-- Filled dynamically -->

                            </div>

                            <div id="documentPagination"
                                 class="border-t border-slate-800">

                                <!-- Filled dynamically -->

                            </div>

                        </div>

                    </section>

                </div>

            </main>

        </section>

    </div>

</div>

<!-- ===================================================== -->
<!-- TOAST CONTAINER                                       -->
<!-- ===================================================== -->

<div id="toastContainer"
     class="pointer-events-none fixed bottom-6 left-1/2 z-[1100] flex w-full max-w-2xs -translate-x-1/2 flex-col items-stretch gap-3 px-4">
</div>

@Html.AntiForgeryToken()

@section Scripts
{
    <script>
        window.Razor = {
            userId:'@Model.User.FindFirstValue(ClaimTypes.NameIdentifier)',
        };
    </script>

    <script src="~/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <script src="~/js/documents/status-badge.js"></script>

    <script src="~/js/documents/document-library-templates.js"></script>
    <script src="~/js/documents/document-library-signalr.js"></script>
    <script src="~/js/documents/document-library.js"></script>
}
