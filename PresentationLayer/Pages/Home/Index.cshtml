@page
@using System.Security.Claims
@model Presentation.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Dashboard";

    var userName = Model.FullName;
    var userEmail = Model.Email;
    var userRole = Model.Role;
    var initial = userName.Length > 0 ? userName[0].ToString().ToUpperInvariant() : "U";
    var isAdmin = User.IsInRole("Admin");
    var isLecturer = User.IsInRole("Lecturer");
}

<style>
    .dashboard-page {
        max-width: 1120px;
        margin: 0 auto;
    }

    .dashboard-hero {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        padding: 6rem 3rem;
        margin-bottom: 3rem;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 520px;
    }

    .dashboard-hero-bg {
        position: absolute;
        inset: 0;
        background-image: url('/images/hero-bg.png');
        background-size: cover;
        background-position: center;
        z-index: 0;
        transition: transform 10s ease;
    }
    
    .dashboard-hero:hover .dashboard-hero-bg {
        transform: scale(1.05);
    }
    
    .dashboard-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(17, 24, 39, 0.2) 0%, rgba(17, 24, 39, 0.85) 100%);
        z-index: 1;
    }

    .dashboard-hero-content {
        position: relative;
        z-index: 2;
        max-width: 840px;
        color: #ffffff;
    }

    .dashboard-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.25rem;
        margin-bottom: 1.5rem;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        animation: fadeInDown 0.6s ease-out forwards;
    }

    .dashboard-hero h1 {
        font-size: 3.75rem;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        letter-spacing: -1px;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .dashboard-hero p {
        font-size: 1.25rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 2.5rem;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        animation: fadeInUp 1s ease-out forwards;
    }
    
    .hero-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        animation: fadeInUp 1.2s ease-out forwards;
    }
    
    .hero-btn-primary {
        padding: 0.875rem 2.25rem;
        border-radius: 12px;
        background: var(--gradient-primary);
        color: white;
        font-size: 1.125rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 25px -5px rgba(46, 204, 113, 0.4);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .hero-btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px -5px rgba(46, 204, 113, 0.6);
        color: white;
    }
    
    .hero-btn-secondary {
        padding: 0.875rem 2.25rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: white;
        font-size: 1.125rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .hero-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.25);
        color: white;
        transform: translateY(-3px);
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }


</style>

<section class="dashboard-page" aria-labelledby="dashboardTitle">
    <div class="dashboard-hero">
        <div class="dashboard-hero-bg"></div>
        <div class="dashboard-hero-overlay"></div>
        <div class="dashboard-hero-content">
            <div class="dashboard-eyebrow">
                <i class="fas fa-robot text-primary"></i>
                <span>Smart Educational Companion</span>
            </div>
            <h1 id="dashboardTitle">Empower Your Learning with EduChatAI</h1>
            <p>Welcome back, @userName! Your personal AI assistant is ready to help you analyze documents, answer questions, and accelerate your studies.</p>
            <div class="hero-actions">
                <a href="/Chat/Index" class="hero-btn-primary">
                    <i class="fas fa-comment-dots me-2"></i> Start Chatting
                </a>
                <a href="/Documents/Library" class="hero-btn-secondary">
                    <i class="fas fa-folder-open me-2"></i> Explore Library
                </a>
            </div>
        </div>
    </div>




</section>

@section Scripts {

    <script src="~/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <script>
        window.Razor = {
            userId: '@User.FindFirstValue(ClaimTypes.NameIdentifier)'
        };
    </script>

    <script src="~/js/home/home-signalr.js"></script>
}
