@model ChatPageVm

@{
    ViewData["Title"] = "AI Assistant";
}

<div id="chat-app"
     class="flex h-[calc(100vh-64px)] overflow-hidden"
     data-active-session-id="@Model.ActiveSessionId">

    <!-- Sidebar -->
    <aside class="w-80 shrink-0 border-r border-border bg-sidebar flex flex-col">

        <!-- Header -->
        <div class="p-4 border-b border-border">

            <button id="btn-new-chat"
                    class="w-full rounded-lg bg-brand px-4 py-3 text-white font-medium hover:bg-brand-dark transition">
                + New Chat
            </button>

            <div class="mt-3 space-y-2">

                <button class="w-full text-left rounded-lg px-3 py-2 hover:bg-sidebar-hover">
                    Search Chats
                </button>

                <button class="w-full text-left rounded-lg px-3 py-2 hover:bg-sidebar-hover">
                    File Library
                </button>

            </div>
        </div>

        <!-- Subjects -->
        <div class="border-b border-border">

            <button id="btn-toggle-subjects"
                    class="w-full flex items-center justify-between px-4 py-3 hover:bg-sidebar-hover">

                <span class="font-medium">
                    Subjects
                </span>

                <span id="subjects-chevron">
                    ▼
                </span>

            </button>

            <div id="subjects-list" class="px-2 pb-2">

                @foreach (var subject in Model.Subjects)
                {
                    <button class="subject-option w-full text-left rounded-lg px-3 py-2 hover:bg-sidebar-hover"
                            data-subject-id="@subject.Id">

                        <div class="font-medium subject-code">
                            @subject.Code
                        </div>

                        <div class="text-xs text-muted subject-name">
                            @subject.Name
                        </div>

                    </button>
                }

            </div>

        </div>

        <!-- Sessions -->
        <div class="flex-1 overflow-y-auto">

            <div class="px-4 py-3 text-sm font-semibold text-muted">
                Your Sessions
            </div>

            <div id="session-list">

                @foreach (var session in Model.Sessions)
                {
                    <button class="chat-session-item w-full text-left px-4 py-3 hover:bg-sidebar-hover"
                            data-session-id="@session.Id">

                        <div class="truncate">
                            @session.Title
                        </div>

                    </button>
                }

            </div>

        </div>

    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col bg-background">

        <div id="chat-main"
             class="flex-1 min-h-0">

            <!-- JS renders here -->

        </div>

    </main>

</div>

@section Scripts
{
    <script>
        window.chatPage = {
            activeSessionId: '@Model.ActiveSessionId'
        };
    </script>

    <script src="~/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/lib/marked/lib/marked.umd.js"></script>

    <script src="~/js/chat/chat-templates.js"></script>
    <script src="~/js/chat/chat-signalr.js"></script>
    <script src="~/js/chat/chat.js"></script>
}
