<Project Sdk="Microsoft.NET.Sdk.Web">

	<ItemGroup>
		<ProjectReference Include="..\Domain\Domain.csproj" />
		<ProjectReference Include="..\BusinessLayer\Business.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="16.1.1" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
		<PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
		<PackageReference Include="Mime" Version="3.8.0" />
		<PackageReference Include="NuGet.Packaging" Version="7.6.0" />
		<PackageReference Include="NuGet.Protocol" Version="7.6.0" />
	</ItemGroup>

	<Target Name="CheckNpm" BeforeTargets="TailwindBuild" Condition="'$(SkipTailwindBuild)' != 'true'">
		<Exec Command="npm --version"
			  IgnoreExitCode="true"
			  ConsoleToMsBuild="true"
			  StandardOutputImportance="Low"
			  StandardErrorImportance="Low">
			<Output TaskParameter="ExitCode" PropertyName="NpmCheckExitCode" />
		</Exec>
	</Target>

	<Target Name="TailwindBuild"
			BeforeTargets="Build"
			DependsOnTargets="CheckNpm"
			Condition="'$(SkipTailwindBuild)' != 'true' and '$(NpmCheckExitCode)' == '0'">
		<Exec Command="npm run tailwind:build" />
	</Target>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>c99ba25d-054d-4d4e-a025-c1790579695f</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
		<ContainerImageTag>educhatai-mvc</ContainerImageTag>
	</PropertyGroup>

</Project>
