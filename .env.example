# Copy to .env and fill only the integrations you intend to use.
# Actual credentials must be exchanged separately and must not be committed.

AI__OpenRouter__ApiKey=
AI__Gemini__ApiKey=

# Optional JSON capability allowlists for the private Python Ragas sidecar.
# Models use LiteLLM identifiers internally; provider/model pairs are persisted with experiment snapshots.
RAGAS_LLM_OPTIONS=[{"provider":"gemini","model":"gemini-2.5-flash","label":"Gemini 2.5 Flash"},{"provider":"ollama","model":"qwen3","label":"Qwen 3 · Ollama"}]
RAGAS_EMBEDDING_OPTIONS=[{"provider":"gemini","model":"gemini-embedding-001","label":"Gemini Embedding 001"},{"provider":"ollama","model":"bge-m3","label":"BGE-M3 · Ollama"}]

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

Email__SenderEmail=
Email__AppPassword=

BlobStorage__Supabase__ApiSecretKey=

PaymentProviders__ZaloPay__Key1=
PaymentProviders__ZaloPay__Key2=
PaymentProviders__ZaloPay__CallbackUrl=
PaymentProviders__ZaloPay__RedirectUrlBase=

AppBaseUrl=http://localhost:8080
